{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2021",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@frutigo/shared": ["../../packages/shared/dist"]
    },
    "declaration": false,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
