# Base de datos PostgreSQL
DATABASE_URL="postgresql://frutigo:frutigo@localhost:5432/frutigo?schema=public"

# Servidor
PORT=3000
PUBLIC_URL="http://localhost:3000"
APP_DEEPLINK_SCHEME="frutigo"
# CORS: dominios permitidos separados por coma (vacío = permitir todos, solo dev)
CORS_ORIGINS=""

# Autenticación
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Vida del access token (corto). El refresh token dura 30 días y rota en cada uso.
JWT_EXPIRES_IN="15m"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Yappy — Botón de Pago (Banco General). Portal Comercios Yappy.
YAPPY_MERCHANT_ID="xxx"
YAPPY_SECRET_KEY="xxx"
YAPPY_BASE_URL="https://apipagosbg.bgeneral.cloud"

# Visa / Mastercard — procesador local (ej. Credomatic / BAC)
VISA_MERCHANT_ID="xxx"
VISA_API_KEY="xxx"
VISA_BASE_URL="https://credomatic.example/api"

# Cripto — Coinbase Commerce (https://commerce.coinbase.com/)
COINBASE_COMMERCE_API_KEY="xxx"
COINBASE_COMMERCE_WEBHOOK_SECRET="xxx"

# Correo (SMTP) — envío de recibos y manifiestos por email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FRUTI GO <no-reply@frutigo.pa>"

# Google Custom Search (imágenes de producto)
# 1. API key: https://console.cloud.google.com/apis/credentials  (habilita "Custom Search API")
# 2. CX: crea un Programmable Search Engine en https://programmablesearchengine.google.com/
#    con "Búsqueda de imágenes" y "Buscar en toda la web" activadas.
GOOGLE_CSE_API_KEY="xxx"
GOOGLE_CSE_CX="xxx"
