{
  "expo": {
    "name": "FRUTI GO",
    "slug": "frutigo",
    "scheme": "frutigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0F3D2E",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pa.frutigo.app"
    },
    "android": {
      "package": "pa.frutigo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D2E"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.pa.frutigo.app",
          "enableGooglePay": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FRUTI GO usa tu ubicación para el seguimiento de entregas en tiempo real."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "stripePublishableKey": "pk_test_xxx",
      "stripeMerchantId": "merchant.pa.frutigo.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1561bb95-089b-49ab-aaef-f59bc30b008d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1561bb95-089b-49ab-aaef-f59bc30b008d"
    }
  }
}
